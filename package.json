{
    "name":  "gulp-git",
    "description":  "Git plugin for gulp (gulpjs.com)",
    "version":  "2.11.0",
    "homepage":  "http://github.com/stevelacy/gulp-git",
    "repository":  {
                       "type":  "git",
                       "url":  "http://github.com/stevelacy/gulp-git.git"
                   },
    "author":  "Steve Lacy me@slacy.me (slacy.me)",
    "main":  "./index.js",
    "dependencies":  {
                         "any-shell-escape":  "^0.1.1",
                         "fancy-log":  "^1.3.2",
                         "lodash":  "^4.17.21",
                         "plugin-error":  "^1.0.1",
                         "require-dir":  "^1.0.0",
                         "strip-bom-stream":  "^3.0.0",
                         "vinyl":  "^2.0.1"
                     },
    "devDependencies":  {
                            "eslint":  "^6.7.2",
                            "mocha":  "^6.2.2",
                            "mock-require":  "^2.0.2",
                            "rimraf":  "^2.6.1",
                            "should":  "^13.2.3"
                        },
    "scripts":  {
                    "docs":  "rimraf docs/* \u0026\u0026 jsdoc ./index.js ./lib --recurse --destination ./docs",
                    "lint":  "rimraf test/repo test/tmp \u0026\u0026 eslint ./index.js ./examples/ ./lib/ ./test/",
                    "test":  "mocha --reporter spec --timeout 6000 test/main.js \u0026\u0026 npm run lint"
                },
    "engines":  {
                    "node":  "\u003e= 0.9.0"
                },
    "license":  "MIT",
    "keywords":  [
                     "gulp",
                     "git",
                     "gulpgit",
                     "gulpplugin",
                     "gulp-plugin"
                 ],
    "bugs":  {
                 "url":  "https://github.com/stephenlacy/gulp-git/issues"
             }
}
